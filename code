#!/usr/bin/env bash
# Auto-rebuilding wrapper for cli-dev
# Usage: alias code='/Users/jinyangli/src/free-code/code'

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CLI_DEV="$SCRIPT_DIR/cli-dev"
REBUILD_FLAG=0

# Auto-install bun if not found
if ! command -v bun &>/dev/null; then
    echo "[code] bun not found, installing..." >&2
    curl -fsSL https://bun.sh/install | bash >&2
    export BUN_INSTALL="$HOME/.bun"
    export PATH="$BUN_INSTALL/bin:$PATH"
    if ! command -v bun &>/dev/null; then
        echo "[code] Failed to install bun!" >&2
        exit 1
    fi
    echo "[code] bun installed: $(bun --version)" >&2
fi

# Auto-install dependencies if node_modules is missing or stale
if [[ ! -d "$SCRIPT_DIR/node_modules" ]] || [[ "$SCRIPT_DIR/bun.lock" -nt "$SCRIPT_DIR/node_modules/.cache/.bun-install-timestamp" ]]; then
    echo "[code] Installing dependencies..." >&2
    (cd "$SCRIPT_DIR" && bun install) >&2
    if [[ $? -ne 0 ]]; then
        echo "[code] Dependency install failed!" >&2
        exit 1
    fi
    mkdir -p "$SCRIPT_DIR/node_modules/.cache"
    touch "$SCRIPT_DIR/node_modules/.cache/.bun-install-timestamp"
fi

# If cli-dev doesn't exist, must build
if [[ ! -f "$CLI_DEV" ]]; then
    REBUILD_FLAG=1
else
    # Check if any src/ or scripts/ file is newer than cli-dev
    if [[ -n "$(find "$SCRIPT_DIR/src" "$SCRIPT_DIR/scripts" "$SCRIPT_DIR/package.json" -newer "$CLI_DEV" -print -quit 2>/dev/null)" ]]; then
        REBUILD_FLAG=1
    fi
fi

if [[ "$REBUILD_FLAG" -eq 1 ]]; then
    echo "[code] Source changes detected, rebuilding cli-dev..." >&2
    (cd "$SCRIPT_DIR" && bun run build:dev:full) >&2
    if [[ $? -ne 0 ]]; then
        echo "[code] Build failed!" >&2
        exit 1
    fi
    echo "[code] Build complete." >&2
fi

exec "$CLI_DEV" "$@"
